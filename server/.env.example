# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173

# Daily Vault Password required to open the app and access your vault
APP_PASSWORD=YourVaultPassword123#

# Permanent Master Admin Recovery Password (can always reset vault password or unlock)
MASTER_ADMIN_PASSWORD=YourPermanentMasterKey#2026

# Notification & Reset Email Destination (locked to owner)
ADMIN_EMAIL=your-email@gmail.com

# Free Email Delivery API (RECOMMENDED for Render / Cloud deployments)
# Cloud platforms like Render block SMTP ports 465/587. Resend works over standard HTTPS (Port 443).
# Get a free key at https://resend.com (3,000 free emails/mo forever, sign in with Google):
RESEND_API_KEY=re_12345678_abcdefghijklmnopqrstuvwxyz
# Optional: defaults to "TelePhotos Vault <onboarding@resend.dev>" (sends directly to your registered Google email)
RESEND_FROM=TelePhotos Vault <onboarding@resend.dev>

# Alternative Free Email API: Brevo (300 free emails/day at https://brevo.com)
BREVO_API_KEY=

# Standard SMTP Email Configuration (Works locally, but often blocked by Render cloud free tier)
# If left empty, OTP codes are logged directly to the server terminal console / Render logs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password

# Cryptographic secret for signing session tokens (Generate a random 32+ char hex key)
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_super_secret_cryptographic_salt_key_here

# PostgreSQL Database Connection String (Prisma)
# Example local: postgresql://postgres:password@localhost:5432/telegram_drive?schema=public
# Example cloud (Neon / Supabase): postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/telegram_drive?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/telegram_drive?schema=public

# Telegram MTProto Credentials (Obtain from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Telegram Bot Token (Obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Private Channel ID (e.g., -1001234567890)
# Make sure your bot is added to this channel as an Administrator with 'Post Messages' rights!
TELEGRAM_CHANNEL_ID=-1001234567890

# Telegram StringSession (Optional for first run)
# The server will output this string on first login.
# Paste it here to persist your session and avoid re-authentication on restarts.
TELEGRAM_SESSION_STRING=

# Parallel MTProto Chunk Workers (1 worker prevents 406: AUTH_KEY_DUPLICATED for bot accounts)
TELEGRAM_UPLOAD_WORKERS=1
