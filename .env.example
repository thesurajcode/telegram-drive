# -------------------------------------------------------------
# Docker Compose Environment Configuration
# -------------------------------------------------------------

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=telegram_drive

# Telegram MTProto Credentials (Obtain from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Telegram Bot Token (Obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Private Channel ID (e.g., -1001234567890)
# Ensure the bot is added as an Administrator with 'Post Messages' rights!
TELEGRAM_CHANNEL_ID=-1001234567890

# Telegram StringSession (Optional for first run)
# On first run, GramJS logs the session string to your terminal.
# Paste it here to prevent re-authentication on container restarts.
TELEGRAM_SESSION_STRING=

# Parallel MTProto Chunk Workers (speeds up large uploads up to 8x)
TELEGRAM_UPLOAD_WORKERS=8

# Master Password required to open the app and access data
APP_PASSWORD=@9525

